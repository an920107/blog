FROM rust:1-slim AS base
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential libssl-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*

FROM base AS builder
WORKDIR /app
# The build context intentionally excludes .env, so there is no DATABASE_URL here:
# verify sqlx macros against the committed .sqlx cache instead of a live database.
ENV SQLX_OFFLINE=true
COPY Cargo.toml Cargo.lock build.rs ./
COPY .sqlx ./.sqlx
COPY migrations ./migrations
COPY server ./server
COPY feature ./feature
RUN cargo build --release -j2

FROM debian:trixie-slim AS runner
RUN apt-get update && \
    apt-get install -y ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/server .
EXPOSE 8080
VOLUME ["/app/static", "/app/embedding_cache"]
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1
ENV HOST=0.0.0.0
ENV PORT=8080
CMD ["./server"]
